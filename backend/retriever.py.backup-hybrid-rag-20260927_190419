"""
Persistent ChromaDB semantic retriever.
Indexes chunks from the selected document and retrieves evidence only from it.
"""

from pathlib import Path
from functools import lru_cache

import chromadb
from sentence_transformers import SentenceTransformer

from backend import storage
from backend.config import settings

MODEL_NAME = "all-MiniLM-L6-v2"
MIN_SIMILARITY = 0.35
COLLECTION_NAME = "document_chunks"


@lru_cache(maxsize=1)
def embedder():
    return SentenceTransformer(MODEL_NAME)


@lru_cache(maxsize=1)
def collection():
    db_path = Path(settings.data_dir) / "chroma_db"
    db_path.mkdir(parents=True, exist_ok=True)

    client = chromadb.PersistentClient(path=str(db_path))
    return client.get_or_create_collection(
        name=COLLECTION_NAME,
        metadata={"hnsw:space": "cosine"}
    )


def index_document(document_name: str) -> None:
    chunks = storage.get_chunks(document_name=document_name)
    if not chunks:
        return

    col = collection()
    ids, documents, metadatas = [], [], []

    for chunk in chunks:
        text = str(chunk.get("text", "")).strip()
        chunk_id = str(chunk.get("id", "")).strip()

        if not text or not chunk_id:
            continue

        ids.append(chunk_id)
        documents.append(text)
        metadatas.append({
            "document_name": str(chunk.get("document_name", document_name)),
            "filename": str(chunk.get("filename", document_name)),
            "chunk_index": int(chunk.get("chunk_index", 0)),
            "page_number": int(chunk.get("page_number") or 0)
        })

    if not ids:
        return

    vectors = embedder().encode(
        documents,
        normalize_embeddings=True,
        show_progress_bar=False
    ).tolist()

    col.upsert(
        ids=ids,
        documents=documents,
        metadatas=metadatas,
        embeddings=vectors
    )


def retrieve(query: str, top_k: int = None, document_name: str = None) -> list[dict]:
    if not document_name:
        return []

    if top_k is None:
        top_k = settings.top_k

    index_document(document_name)

    query_vector = embedder().encode(
        [query],
        normalize_embeddings=True,
        show_progress_bar=False
    ).tolist()

    result = collection().query(
        query_embeddings=query_vector,
        n_results=max(1, top_k),
        where={"document_name": document_name},
        include=["documents", "metadatas", "distances"]
    )

    documents = result.get("documents", [[]])[0]
    metadatas = result.get("metadatas", [[]])[0]
    distances = result.get("distances", [[]])[0]

    results = []
    for text, metadata, distance in zip(documents, metadatas, distances):
        similarity = 1.0 - float(distance)

        if similarity < MIN_SIMILARITY:
            continue

        results.append({
            "id": "",
            "text": text,
            "filename": metadata.get("filename", document_name),
            "document_name": metadata.get("document_name", document_name),
            "chunk_index": int(metadata.get("chunk_index", 0)),
            "page_number": int(metadata.get("page_number", 0)) or None,
            "score": round(similarity, 4)
        })

    return results


def search(query: str, top_k: int = None, document_name: str = None) -> list[dict]:
    return retrieve(query, top_k, document_name)

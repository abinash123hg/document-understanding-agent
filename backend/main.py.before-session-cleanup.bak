"""FastAPI app - run: uvicorn main:app --port 8000 (from backend folder)."""
import logging
import shutil
import uuid
from pathlib import Path

from fastapi import FastAPI, UploadFile, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from backend.config import settings
from backend import processor, retriever, storage, llm
from backend.models import ChatRequest, ChatResponse, Source, utc_now

logging.basicConfig(level=logging.INFO)
app = FastAPI(title="Document Understanding Agent", version="1.0.0")
app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.cors_origins.split(","),
    allow_methods=["*"],
    allow_headers=["*"],
)

ALLOWED = {".pdf", ".txt", ".docx", ".md", ".png", ".jpg", ".jpeg"}


@app.get("/health")
def health():
    return {
        "status": "ok",
        "llm_ready": llm.is_ollama_ready(),
        "llm_model": settings.llm_model,
        "chunk_count": len(storage.list_chunks()),
    }


@app.post("/upload")
async def upload(file: UploadFile):
    ext = Path(file.filename).suffix.lower()
    if ext not in ALLOWED:
        raise HTTPException(400, f"File type {ext} not allowed. Use: {', '.join(sorted(ALLOWED))}")
    save_path = settings.uploads_dir / f"{uuid.uuid4()}{ext}"
    with open(save_path, "wb") as f:
        shutil.copyfileobj(file.file, f)
    try:
        result = processor.process_upload(save_path, file.filename)
    except Exception as e:
        logging.exception("Processing failed")
        raise HTTPException(500, f"Processing failed: {e}")
    finally:
        save_path.unlink(missing_ok=True)  # keep only extracted text
    if result["status"] == "FAILED":
        raise HTTPException(422, result["error"])
    return {
        "filename": file.filename,
        "status": result["status"],
        "extraction_method": result["extraction_method"],
        "chunk_count": result["chunk_count"],
        "time": utc_now(),
    }


@app.post("/chat", response_model=ChatResponse)
def chat(req: ChatRequest):
    sources = retriever.search(req.question)
    if not sources:
        return ChatResponse(
            answer="The uploaded documents do not contain this information.",
            sources=[],
        )
    try:
        answer = llm.generate_answer(req.question, sources)
    except RuntimeError as e:
        return ChatResponse(answer="", sources=[Source(**s) for s in sources], error=str(e))
    return ChatResponse(answer=answer, sources=[Source(**s) for s in sources])

import backend.session_cleanup

:root {
  --bg: #0f1115;
  --bg-gradient: linear-gradient(180deg, #1a1d2d 0%, #0f1115 40%);
  --panel: #151921;
  --panel-hover: #1a1f29;
  --panel2: #1c2230;
  --line: #2a3142;
  --line-light: #364052;
  --text: #f0f2f5;
  --text-secondary: #9ca3af;
  --text-muted: #6b7280;
  --accent: #6366f1;
  --accent-hover: #818cf8;
  --accent-glow: rgba(99, 102, 241, 0.15);
  --good: #10b981;
  --good-bg: rgba(16, 185, 129, 0.1);
  --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.5);
  --radius: 14px;
  --radius-sm: 10px;
  --radius-lg: 18px;
  --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg-gradient);
  color: var(--text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}

.app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Header */
header {
  height: 72px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  padding: 0 32px;
  gap: 16px;
  background: rgba(15, 17, 21, 0.85);
  backdrop-filter: blur(16px);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background: var(--accent-glow);
  flex-shrink: 0;
}

.logo {
  width: 32px;
  height: 32px;
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}

.logo.thinking {
  animation: rotate 1.5s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.header-content {
  flex: 1;
}

h1 {
  font-size: 17px;
  font-weight: 600;
  margin: 0;
  letter-spacing: -0.02em;
}

header p {
  margin: 3px 0 0;
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 400;
}

.status {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--good);
  font-size: 13px;
  font-weight: 500;
  padding: 6px 12px;
  background: var(--good-bg);
  border-radius: 20px;
  flex-shrink: 0;
}

.status-dot {
  width: 8px;
  height: 8px;
  background: var(--good);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.95); }
}

.status.error {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}

.status.error .status-dot {
  background: #ef4444;
}

.status.thinking {
  color: var(--accent);
  background: var(--accent-glow);
}

.status.thinking .status-dot {
  background: var(--accent);
}

/* Layout */
.layout {
  display: grid;
  grid-template-columns: 300px 1fr;
  max-width: 1400px;
  margin: auto;
  min-height: calc(100vh - 72px);
  width: 100%;
}

aside {
  padding: 24px 20px;
  border-right: 1px solid var(--line);
  background: rgba(21, 25, 33, 0.5);
}

main {
  display: flex;
  flex-direction: column;
  max-width: 900px;
  width: 100%;
  margin: auto;
  padding: 32px 40px;
}

/* Cards */
.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

.card:hover {
  border-color: var(--line-light);
  box-shadow: var(--shadow-lg);
}

h3 {
  margin: 0 0 10px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 8px;
  letter-spacing: -0.01em;
}

.muted {
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.6;
}

.tips ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.tips li {
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.7;
  padding: 6px 0;
  padding-left: 20px;
  position: relative;
}

.tips li:before {
  content: "•";
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: bold;
}

/* File upload */
.filebox {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 2px dashed var(--line-light);
  border-radius: var(--radius);
  padding: 18px;
  color: var(--text-secondary);
  cursor: pointer;
  margin: 18px 0 12px;
  transition: var(--transition);
  font-weight: 500;
  font-size: 14px;
}

.filebox:hover {
  border-color: var(--accent);
  background: var(--accent-glow);
  color: var(--text);
}

.upload-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}

input[type="file"] {
  display: none;
}

/* Buttons */
button {
  border: 0;
  border-radius: var(--radius-sm);
  padding: 12px 18px;
  color: white;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  width: 100%;
  padding: 13px 20px;
  box-shadow: 0 4px 14px var(--accent-glow);
}

.primary:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px var(--accent-glow);
}

.primary:active {
  transform: translateY(0);
}

.send {
  width: 44px;
  height: 44px;
  background: var(--accent);
  border-radius: var(--radius);
  padding: 0;
  flex-shrink: 0;
  box-shadow: 0 4px 12px var(--accent-glow);
}

.send:hover {
  background: var(--accent-hover);
  transform: scale(1.05);
  box-shadow: 0 6px 16px var(--accent-glow);
}

.send:active {
  transform: scale(0.98);
}

.message {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 14px;
  white-space: pre-wrap;
  line-height: 1.6;
  padding: 10px 12px;
  background: var(--panel2);
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
}

/* Chat */
.chat {
  flex: 1;
  overflow-y: auto;
  padding: 10px 0 20px;
  margin-bottom: 16px;
  scroll-behavior: smooth;
}

.chat::-webkit-scrollbar {
  width: 6px;
}

.chat::-webkit-scrollbar-track {
  background: transparent;
}

.chat::-webkit-scrollbar-thumb {
  background: var(--line);
  border-radius: 3px;
}

.chat::-webkit-scrollbar-thumb:hover {
  background: var(--line-light);
}

.welcome {
  text-align: center;
  margin: auto;
  padding: 100px 20px;
  color: var(--text-secondary);
  max-width: 500px;
}

.welcome-icon {
  width: 72px;
  height: 72px;
  margin: 0 auto 24px;
  color: var(--accent);
  opacity: 0.8;
}

.welcome h2 {
  color: var(--text);
  font-size: 26px;
  margin: 0 0 12px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.welcome p {
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* Message bubbles */
.bubble {
  max-width: 85%;
  padding: 16px 20px;
  border-radius: var(--radius-lg);
  margin: 14px 0;
  line-height: 1.7;
  white-space: pre-wrap;
  font-size: 14.5px;
  animation: fadeIn 0.3s ease-out;
  box-shadow: var(--shadow);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.user {
  margin-left: auto;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  border: 1px solid rgba(99, 102, 241, 0.3);
  color: white;
}

.assistant {
  background: var(--panel);
  border: 1px solid var(--line);
  color: var(--text);
}

.sources {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.8;
}

.sources strong {
  color: var(--text);
  font-weight: 600;
  display: block;
  margin-bottom: 6px;
}

/* Composer */
.composer {
  position: relative;
}

.composer-wrapper {
  display: flex;
  gap: 10px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 8px;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

.composer-wrapper:focus-within {
  border-color: var(--accent);
  box-shadow: var(--shadow), 0 0 0 3px var(--accent-glow);
}

.composer textarea {
  flex: 1;
  resize: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font: 14.5px inherit;
  font-family: inherit;
  padding: 12px 14px;
  line-height: 1.6;
  max-height: 200px;
}

.composer textarea::placeholder {
  color: var(--text-muted);
}

.hint {
  text-align: center;
  color: var(--text-muted);
  font-size: 12px;
  margin-top: 12px;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }
  
  aside {
    border-right: 0;
    border-bottom: 1px solid var(--line);
    padding: 20px 16px;
  }
  
  main {
    padding: 24px 20px;
  }
  
  header {
    padding: 0 20px;
  }
  
  .bubble {
    max-width: 92%;
  }
}

@media (max-width: 600px) {
  h1 {
    font-size: 15px;
  }
  
  header p {
    font-size: 11px;
  }
  
  .status-text {
    display: none;
  }
  
  .status {
    padding: 6px 10px;
  }
}

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Document Understanding Agent</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="app">
<header>
<div class="logo-container">
<div class="logo">
<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2" fill="none"/>
<path d="M20 8 L20 20 L28 26" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
<circle cx="20" cy="20" r="3" fill="currentColor"/>
</svg>
</div>
</div>
<div class="header-content">
<h1>Document Understanding Agent</h1>
<p>Private document chat · 100% offline</p>
</div>
<div id="status" class="status">
<span class="status-dot"></span>
<span class="status-text">Ready</span>
</div>
</header>
<div class="layout">
<aside>
<div class="card">
<h3>Upload documents</h3>
<p class="muted">PDF, DOCX, TXT, MD and images</p>
<input id="fileInput" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.txt,.docx,.md">
<label for="fileInput" class="filebox">
<svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
</svg>
<span>Choose files</span>
</label>
<button id="uploadBtn" class="primary">Upload selected files</button>
<div id="uploadStatus" class="message"></div>
</div>
<div class="card tips">
<h3>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
<circle cx="12" cy="12" r="10"/>
<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
</svg>
Tips
</h3>
<ul>
<li>Ask questions about the uploaded documents</li>
<li>Use natural language for best results</li>
<li>Answers include source chunks for verification</li>
</ul>
</div>
</aside>
<main>
<div id="chat" class="chat">
<div class="welcome">
<div class="welcome-icon">
<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2" fill="none" opacity="0.3"/>
<path d="M24 12 L24 24 L32 30" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
<circle cx="24" cy="24" r="4" fill="currentColor"/>
</svg>
</div>
<h2>Ask anything about your documents</h2>
<p>Upload a document, then ask a clear question to get started.</p>
</div>
</div>
<div class="composer">
<div class="composer-wrapper">
<textarea id="question" rows="1" placeholder="Ask a question about your documents..."></textarea>
<button id="askBtn" class="send">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
<path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 11L11 13" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</button>
</div>
</div>
<div class="hint">Press Enter to send · Your data stays on this machine</div>
</main>
</div>
</div>
<script src="app.js"></script>
</body>
</html>

const API="http://127.0.0.1:8000";

const $=id=>document.getElementById(id);
const chat=$("chat");
const status=$("status");
const logo=document.querySelector(".logo");
const uploadBtn=$("uploadBtn");
const fileInput=$("fileInput");
const uploadStatus=$("uploadStatus");
const askBtn=$("askBtn");
const question=$("question");
let isThinking=false;

function setStatus(state,text){
  if(status){
    status.className="status "+state;
    const dot=status.querySelector(".status-dot");
    const label=status.querySelector(".status-text");
    if(dot) dot.style.display="block";
    if(label) label.textContent=text;
  }
  if(logo) logo.classList.toggle("thinking",state==="thinking");
  isThinking=state==="thinking";
}

function bubble(text,kind,sources=[]){
  const d=document.createElement("div");
  d.className="bubble "+kind;

  const content=document.createElement("div");
  content.className="bubble-content";
  content.textContent=text;
  d.appendChild(content);

  if(sources.length){
    const s=document.createElement("div");
    s.className="sources";
    const title=document.createElement("strong");
    title.textContent="Sources:";
    s.appendChild(title);

    const unique=new Set();
    sources.forEach(x=>{
      const key=`${x.filename}|${x.chunk_index}`;
      if(unique.has(key)) return;
      unique.add(key);
      const line=document.createElement("div");
      line.textContent=`${x.filename} · part ${x.chunk_index}`;
      s.appendChild(line);
    });
    d.appendChild(s);
  }

  chat.appendChild(d);
  chat.scrollTop=chat.scrollHeight;
}

if(uploadBtn) uploadBtn.onclick=async()=>{
  const files=fileInput?.files;
  if(!files || !files.length){
    uploadStatus.textContent="⚠ Choose a file first.";
    return;
  }

  uploadBtn.disabled=true;
  uploadStatus.textContent="⏳ Uploading...";
  setStatus("thinking","Uploading");

  let completed=0;

  for(const file of files){
    const form=new FormData();
    form.append("file",file);

    try{
      const response=await fetch(`${API}/upload`,{
        method:"POST",
        body:form
      });
      const data=await response.json();

      if(!response.ok) throw new Error(data.detail||"Upload failed");

      completed++;
      uploadStatus.textContent=
        `✓ Uploaded: ${data.filename}\n${data.chunk_count} chunks processed`;
    }catch(error){
      uploadStatus.textContent=`✗ Upload failed: ${error.message}`;
      setStatus("error","Backend error");
    }
  }

  uploadBtn.disabled=false;

  if(completed>0) setStatus("ready","Ready");
};

if(askBtn) askBtn.onclick=async()=>{
  const text=question?.value.trim();
  if(!text || isThinking) return;

  document.querySelector(".welcome")?.remove();
  bubble(text,"user");
  question.value="";
  setStatus("thinking","Thinking");

  try{
    const response=await fetch(`${API}/chat`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({question:text})
    });
    const data=await response.json();

    if(!response.ok) throw new Error(data.detail||"Request failed");

    bubble(
      data.answer||"No answer returned.",
      "assistant",
      data.sources||[]
    );
    setStatus("ready","Ready");
  }catch(error){
    bubble(`Error: ${error.message}`,"assistant");
    setStatus("error","Backend error");
  }
};

if(question){
  question.addEventListener("keydown",event=>{
    if(event.key==="Enter"&&!event.shiftKey){
      event.preventDefault();
      askBtn?.click();
    }
  });

  question.addEventListener("input",()=>{
    question.style.height="auto";
    question.style.height=Math.min(question.scrollHeight,200)+"px";
  });
}

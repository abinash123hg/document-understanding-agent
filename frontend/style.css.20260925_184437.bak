:root {
  color-scheme: light;
  --bg: #f4f7fb;
  --panel: #ffffff;
  --border: #dbe3ef;
  --text: #172033;
  --muted: #64748b;
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --user: #e0ecff;
  --assistant: #f1f5f9;
  --danger: #b91c1c;
  --success: #15803d;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.app-shell {
  width: min(1400px, 100%);
  min-height: 100vh;
  margin: auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 24px clamp(16px, 4vw, 48px);
  background: var(--panel);
  border-bottom: 1px solid var(--border);
}

h1, h2, p { margin-top: 0; }

h1 { margin-bottom: 6px; font-size: clamp(1.3rem, 3vw, 2rem); }
h2 { margin-bottom: 10px; font-size: 1rem; }

.topbar p, .muted, .hint {
  color: var(--muted);
  font-size: .9rem;
  margin-bottom: 0;
}

.status {
  border-radius: 999px;
  padding: 7px 12px;
  font-size: .85rem;
  font-weight: 700;
  white-space: nowrap;
}

.status.ready { color: var(--success); background: #dcfce7; }
.status.busy { color: #92400e; background: #fef3c7; }
.status.error { color: var(--danger); background: #fee2e2; }

.layout {
  display: grid;
  grid-template-columns: minmax(240px, 320px) 1fr;
  gap: 20px;
  padding: 20px clamp(16px, 4vw, 48px);
}

.sidebar, .chat-panel { min-width: 0; }

.panel, .chat-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
}

.panel {
  padding: 18px;
  margin-bottom: 20px;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

input[type="file"] {
  display: block;
  width: 100%;
  margin: 14px 0;
  font-size: .85rem;
}

button {
  border: 0;
  border-radius: 9px;
  cursor: pointer;
  font: inherit;
}

button:disabled {
  cursor: not-allowed;
  opacity: .55;
}

.primary {
  width: 100%;
  padding: 11px 14px;
  color: white;
  background: var(--primary);
  font-weight: 700;
}

.primary:hover:not(:disabled) { background: var(--primary-dark); }

.small-button {
  padding: 6px 9px;
  color: var(--danger);
  background: #fee2e2;
  font-size: .78rem;
}

.message {
  margin-top: 12px;
  color: var(--muted);
  font-size: .85rem;
  line-height: 1.45;
}

.message.error { color: var(--danger); }
.message.success { color: var(--success); }

.documents, .history-list {
  display: grid;
  gap: 8px;
  margin-top: 14px;
}

.document-item, .history-item {
  width: 100%;
  padding: 10px;
  text-align: left;
  background: #f8fafc;
  border: 1px solid var(--border);
  border-radius: 9px;
  overflow-wrap: anywhere;
}

.document-item.active {
  border-color: var(--primary);
  background: #eff6ff;
}

.document-item button {
  width: 100%;
  color: var(--text);
  background: transparent;
  text-align: left;
}

.history-item {
  cursor: pointer;
}

.history-item:hover { border-color: var(--primary); }

.history-question {
  display: block;
  font-size: .84rem;
  font-weight: 700;
  line-height: 1.35;
}

.history-meta {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: .72rem;
}

.chat-panel {
  display: flex;
  min-height: 620px;
  flex-direction: column;
  overflow: hidden;
}

.chat {
  flex: 1;
  min-height: 460px;
  padding: clamp(16px, 4vw, 30px);
  overflow-y: auto;
}

.empty-state {
  max-width: 520px;
  margin: 80px auto;
  color: var(--muted);
  text-align: center;
}

.bubble {
  max-width: min(850px, 90%);
  margin-bottom: 18px;
  padding: 14px 16px;
  border-radius: 14px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.bubble.user {
  margin-left: auto;
  background: var(--user);
}

.bubble.assistant {
  margin-right: auto;
  background: var(--assistant);
}

.bubble-label {
  display: block;
  margin-bottom: 6px;
  color: var(--muted);
  font-size: .76rem;
  font-weight: 700;
  text-transform: uppercase;
}

.bubble-content {
  white-space: pre-wrap;
}

.sources {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: .78rem;
}

.sources ul {
  margin: 7px 0 0 18px;
  padding: 0;
}

.composer {
  display: flex;
  gap: 10px;
  padding: 16px;
  border-top: 1px solid var(--border);
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 48px;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 9px;
  color: var(--text);
  font: inherit;
}

.composer .primary {
  width: 100px;
  align-self: end;
}

.hint {
  padding: 0 16px 14px;
  text-align: right;
}

@media (max-width: 800px) {
  .layout { grid-template-columns: 1fr; }
  .chat-panel { min-height: 560px; }
  .chat { min-height: 380px; }
}

@media (max-width: 520px) {
  .topbar { align-items: flex-start; flex-direction: column; }
  .composer { flex-direction: column; }
  .composer .primary { width: 100%; }
  .bubble { max-width: 100%; }
}

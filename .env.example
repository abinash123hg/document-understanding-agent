# Copy this file to .env to change any value. Everything listed here is
# already the built-in default, so the application runs without a .env file.

# --- Local LLM (Ollama) -----------------------------------------------------
# The model has to be pulled beforehand. The application refuses to send a
# chat request for a model Ollama does not have, because Ollama would otherwise
# start downloading it silently.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:1.5b

# --- Handwriting recognition ------------------------------------------------
# Downloaded from Hugging Face once, on the first page that needs it.
HTR_MODEL=microsoft/trocr-base-handwritten
HTR_MAX_TOKENS=64
# Pages recognised below this confidence are refused instead of answered.
HTR_MIN_CONFIDENCE=0.30

# --- Scanned PDF handling ---------------------------------------------------
PDF_DPI=200
PDF_MAX_DIMENSION=2000
# Upper bound on OCR pages per file, so a huge scan fails instead of hanging.
PDF_MAX_OCR_PAGES=50

# --- Uploads and retrieval --------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
TOP_K=4
CHUNK_SIZE=400
CHUNK_OVERLAP=60

# --- Browser access ---------------------------------------------------------
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Storage ----------------------------------------------------------------
# Defaults to a data/ folder next to the repository root.
# DATA_DIR=./data

# Copy this file to .env to change any value. Everything listed here is
# already the built-in default, so the application runs without a .env file.
#
# Size budget on this laptop: qwen2.5:3b is 1.9 GB and trocr-base is 1.3 GB.
# There is no GPU anywhere in this project and no CUDA wheel is required.

# --- Local LLM (Ollama) -----------------------------------------------------
# The model has to be pulled beforehand:
#     ollama pull qwen2.5:3b
# The application refuses to send a chat request for a model Ollama does not
# have, because Ollama would otherwise start downloading it silently.
# qwen2.5:1.5b drops citation labels often enough to be refused on its own
# output, and qwen2.5:7b is 4.7 GB, which breaks the budget next to TrOCR.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b

# --- Handwriting recognition ------------------------------------------------
# Downloaded from Hugging Face once, on the first page that needs it.
HTR_MODEL=microsoft/trocr-base-handwritten
HTR_MAX_TOKENS=64
# Chunks holding handwriting scored below this are not shown to the model at all,
# so they cannot be cited. Each chunk carries the minimum confidence of the
# handwriting lines inside it, not the page average.
HTR_MIN_CONFIDENCE=0.30
# Handwriting lines decoded per TrOCR call. Larger batches do not help on CPU.
TROCR_LINE_BATCH=4

# --- Printed scans ----------------------------------------------------------
# A page with no text layer is read by Tesseract first, which is far faster than
# TrOCR, and only a page Tesseract cannot read goes to TrOCR.
# This needs the Tesseract binary installed separately; the pip package is only
# the wrapper. On Windows: install tesseract-ocr (https://github.com/UB-Mannheim
# /tesseract or winget install UB-Mannheim.TesseractOCR) and make sure
# tesseract.exe is on PATH. If it is missing the page still gets recognised,
# just slowly, and the upload does not fail.
PRINTED_SCAN_OCR=true
DENOISE_IMAGES=false

# --- Scanned PDF handling ---------------------------------------------------
# 150 DPI is where these pages stop gaining accuracy and start costing seconds.
PDF_DPI=150
PDF_MAX_DIMENSION=2000
# Upper bound on OCR pages per file, so a huge scan fails instead of hanging.
# Keep this at 40: it is the point where one upload stays inside a few minutes.
PDF_MAX_OCR_PAGES=40
# Pages recognised at the same time. Two caps memory use on a laptop CPU.
OCR_PAGES_AT_A_TIME=2

# --- Retrieval --------------------------------------------------------------
# Excerpts handed to the model for a fact question.
TOP_K=6
CHUNK_SIZE=400
CHUNK_OVERLAP=60
# How far below the best cross-encoder score a candidate may sit and still be
# handed to the model. Raise it to pass more excerpts, lower it to be stricter.
RERANK_MARGIN=2.5
# Candidate pool reaching the reranker. It grows with the document (a fixed pool
# covers 8% of a 150-chunk file but 0.8% of a 1,500-chunk one) and stops at
# RERANK_CANDIDATES_MAX, which is what keeps a book inside laptop RAM.
RERANK_CANDIDATES=24
RERANK_CANDIDATES_MAX=40
# Excerpts for a request about the whole document ("summarize this"), deliberately
# wider than TOP_K: no chunk *is* the summary, so the model has to see enough of
# the file to describe it. Measured on a 13-page scanned deck - at 6 chunks the
# model answered "summarize this document" with the refusal string every time, and
# at 10 it produced the deck's actual topics.
OVERVIEW_CHUNKS=10
# Each factual claim in a draft is verified on its own pass. This cap is a CPU
# budget, not a trust budget: on this laptop every extra check is another second
# or two, so a claim past it is dropped unverified and the answer is marked partial.
MAX_CLAIMS_PER_ANSWER=5

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100

# --- Browser access ---------------------------------------------------------
# The page is served from port 5500, but index.html also works when opened off
# the backend's own port, and Live Server uses 5500 too. All four are allowed by
# default. A wildcard is not: the middleware runs with credentials enabled.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# --- Storage ----------------------------------------------------------------
# Defaults to a data/ folder next to the repository root.
# DATA_DIR=./data
